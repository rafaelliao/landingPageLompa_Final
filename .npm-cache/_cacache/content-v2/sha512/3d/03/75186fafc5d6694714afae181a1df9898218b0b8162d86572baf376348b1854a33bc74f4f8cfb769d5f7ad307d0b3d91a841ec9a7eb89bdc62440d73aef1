/preset-react":"^7.14.5","@babel/preset-typescript":"^7.15.0","@types/react":"^17.0.30","cross-env":"^7.0.3","react":"^17.0.2","react-dom":"^17.0.2","rimraf":"^3.0.2"},"readme":"# framer-motion-carousel\n\nA simple `framer-motion-carousel`, used for `framer-motion`, `chakra-ui`\nsupport `click` and `swipe`, support custom `arrows`, `dots`, easy to use.\n## Basic Usage\n\n```jsx\nimport * as React from \"react\";\nimport Carousel from \"framer-motion-carousel\";\n\nconst colors = [\"#f90\", \"#ef0\", \"#e0f\"];\n\nconst App = () => (\n  <div style={{ width: 600, height: 400 }}>\n    <Carousel>\n      {colors.map((item, i) => (\n        <div\n          key={i}\n          style={{\n            width: \"100%\",\n            height: \"100%\",\n            backgroundColor: colors[i],\n          }}\n        ></div>\n      ))}\n    </Carousel>\n  </div>\n);\nexport default App;\n```\n\n## images carousel\n\n`img` element should add `draggable=false`\n\n```jsx\n<div style={{ width: 600, height: 400, margin: \"0 auto\" }}>\n  <Carousel>\n    {[1, 2, 3, 4].map((item, i) => (\n      <img\n        draggable=\"false\"\n        src={`./${item}.jpg`}\n        key={i}\n        width=\"100%\"\n        alt=\"\"\n      />\n    ))}\n  </Carousel>\n</div>\n```\n\n## Example\n\n[Live Demo](https://carousel-app-772051431.vercel.app)\n\n![example](./img.jpg)\n\n\n## props\n\n| props            | type                                                                                 | default | description        |\n|------------------|--------------------------------------------------------------------------------------|---------|--------------------|\n| loop             | boolean                                                                              | true    | loop play          |\n| autoPlay         | boolean                                                                              | true    | auto play          |\n| interval         | number                                                                               | 2000    | auto play interval |\n| renderArrowLeft  | ({handlePrev: () => void, activeIndex: number}) => React.ReactNode                   | null    | custom your arrows |\n| renderArrowRight | ({handleNext: () => void, activeIndex: number}) => React.ReactNode                   | null    | custom your arrows |\n| renderDots       | ({activeIndex: number, setActiveIndex: (index: number) => void;}) => React.ReactNode | null    | custom your dots   |\n\n\n\n## example\n\n```\ncd example && yarn install\n\nyarn dev\n```","readmeFilename":"README.md","gitHead":"b2307a79fab4c8786fea547746aa0361fcb60bb6","bugs":{"url":"https://github.com/jiangbo2015/framer-motion-carousel/issues"},"_id":"framer-motion-carousel@2.0.0-beta.0","_nodeVersion":"14.17.0","_npmVersion":"7.21.0","dist":{"integrity":"sha512-Z6Ou8qAE2Rx/zcD/T+NEd2kAhlhzyn6FRuGJRGzKyh5yeA1g2yIe9jteUQNwert+EagpCWPRYrduzNfZfova2Q==","shasum":"b193b570d2a707b68f81209e5358f33336a0f9f2","tarball":"https://registry.npmjs.org/framer-motion-carousel/-/framer-motion-carousel-2.0.0-beta.0.tgz","fileCount":38,"unpackedSize":60658,"signatures":[{"keyid":"SHA256:jl3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA","sig":"MEYCIQCZw0B2pthVxJpxeHm2MXFk/8ki+Q/Tu09HJ71CCwZ1vAIhAIBXicjxQpNWdFFDipTdoZRepuQkndqhnYo+Bb4enDam"}],"npm-signature":"-----BEGIN PGP SIGNATURE-----\r\nVersion: OpenPGP.js v4.10.10\r\nComment: https://openpgpjs.org\r\n\r\nwsFzBAEBCAAGBQJirtnGACEJED1NWxICdlZqFiEECWMYAoorWMhJKdjhPU1b\r\nEgJ2Vmo6bg/8DDkE2aIUusWwNRO0EqYS5j8ha2FcuSwrWS2k1nEjZRjs55tF\r\nZA8EJjB6PHpLYeseto65fDWhW2JmU2omZ2ZKbE++UdeCoscK98RnYEtPAtIE\r\nqNr0PuANY5ujqsN72ge/HZv7hNvaRnBCZfPTrQd31kww3odymU36q94xDVrh\r\nswXlOniQosKysSc0QbGkRUr91xaqHh55B1O5prBNlCqIgo4apxhTnbsS/G1s\r\nK9GZCGokY991mVqSkif87+Q5IzTWb3mdQ06+etzclPwkCJnoEh1X5XK9DQ0S\r\n7V9KYQzzotYuXNxmq2jI+/v0Rl7yhmCiNBmnqU9HV4/uPnmFwTaytEudHmAA\r\n7kYS/mRKpiMPskQfmb4RA79buJvLnYmZ3oTD387HsyMJweQLOTZ6EcEkSW9u\r\nXYXNLVxaUiPe51KDpQMYTWAsis8rriU3hIFVOhPdG7r+3QULbTSUfpqZt+gX