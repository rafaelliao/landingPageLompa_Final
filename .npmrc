# Configurações de Performance
cache=.npm-cache
prefer-offline=true
audit=false
fund=false

# Configurações de Segurança
save-exact=true
package-lock=true

# Configurações de Desenvolvimento
loglevel=error
progress=false

# Configurações de Cache
cache-min=3600
cache-max=infinity

# Configurações de Registry
registry=https://registry.npmjs.org/ 